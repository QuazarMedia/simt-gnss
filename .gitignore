# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/

# Local configuration file (SDK path). Never commit — it is machine-specific.
local.properties

# Release signing keystore — NEVER commit.
# *.jks
#*.keystore

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log
kotlin-compiler-*

# Kotlin / tooling caches
.kotlin/
**/.kotlin/

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
# Exclude the entire .idea folder usually, but some teams keep parts.
# Standard Android practice often ignores strictly user-specific files.
# However, we keep code style files for consistent formatting across IDEs,
# and shared run configurations (release prep) for the team.
# NOTE: the .idea/* catch-all must come before the ! negations for them to apply.
.idea/*
!.idea/codeStyles/
!.idea/editorconfig.xml
!.idea/runConfigurations/

# External native build folder generated in Android Studio for NDK
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
# google-services.json

# OSX
.DS_Store

# Windows
Thumbs.db

scripts/*.tif
**/__pycache__/*

# opencode harness state (goals) — not project source
.opencode/goals

# Per-developer git identity, written by `simt init`. Not a file to share:
# it carries whoever is committing into the tree, and a repository has more than
# one of those.
git.config

# JS tooling (simt-dev gate)
node_modules/
