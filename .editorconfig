# simt:begin
# simt:generated
# simt:sha=898d5a50f1f2b8f1e47875bad8195f766d448bf2
# Generated content. Do not edit by hand - your changes are overwritten.
# Run `simt sync --yes` to regenerate, or `simt check` to see what is stale.

root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a hard line break in Markdown. Stripping them there is not
# tidiness; it deletes meaning the author wrote.
trim_trailing_whitespace = false

[*.{js,mjs,cjs,jsx,ts,tsx,json,jsonc,css,scss,html,yml,yaml}]
indent_style = space
indent_size = 2

[*.{py,pyi,java,kt,kts}]
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab

[{*.go,*.proto}]
indent_style = tab

# simt:end

# ---------------------------------------------------------------------------
# Repository settings (outside the simt region; simt sync never rewrites these).
# ---------------------------------------------------------------------------

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf

# Kotlin (ktlint rules for `spotlessApply`)
[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 300
continuation_indent_size = 4
ktlint_standard_no-wildcard-imports = disabled
ktlint_standard_function-naming = disabled

[*.md]
max_line_length = off

[*.json]
indent_style = space
indent_size = 2

[*.{yml,yaml,toml}]
indent_style = space
indent_size = 2
